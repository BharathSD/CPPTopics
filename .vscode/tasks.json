{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Init build directories",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"New-Item -ItemType Directory -Path \"$PWD/build\",\"$PWD/build/release\" -Force | Out-Null"
			],
			"group": "build"
		},
			{
				"type": "cppbuild",
				"label": "Build with MSVC",
				"dependsOn": "Init build directories",
				"command": "cl.exe",
			"args": [
				"/Zi",
				"/std:c++latest",
				"/EHsc",
				"/Fe:",
				"${fileDirname}\\build\\${fileBasenameNoExtension}.exe",
				"${file}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$msCompile"
			],
					 "group": {
						 "kind": "build"
					 },
					 "detail": "compiler: cl.exe"
		},
			{
				"label": "Build Release with MSVC",
				"type": "cppbuild",
				"dependsOn": "Init build directories",
				"command": "cl.exe",
			"args": [
				"/O2",
				"/DNDEBUG",
				"/std:c++latest",
				"/EHsc",
				"/MD",
				"/Fe:",
				"${fileDirname}\\\\build\\\\release\\\\${fileBasenameNoExtension}.exe",
				"${file}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$msCompile"
			],
					 "group": {
						 "kind": "build"
					 },
					 "detail": "compiler: cl.exe"
		}
	]
}